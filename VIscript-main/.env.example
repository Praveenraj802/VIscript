# VisualIQ Enterprise Production Environment Configuration
# Copy this file to .env and configure with your production credentials

# Application Environment (development | production)
APP_ENV=production

# Security & Cryptography
# Generate a secure key (min 32 chars): python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars-long

# Allowed CORS Origins (comma-separated, without trailing slashes)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-domain.com
PORT=8000

# AI Provider Selection: gemini | groq | ollama
VISION_PROVIDER=gemini

# Primary Vision / LLM (Gemini 2.5 Flash)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# Groq Vision & Text Secondary Fallback (Llama 4 Scout / 3.2 Vision)
GROQ_API_KEY=your-groq-api-key
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TEXT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Local Ollama Fallback (Optional, zero cloud cost on local GPU)
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3-vl:8b

# Supabase (PostgreSQL 16 + Auth + Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Vector Store (ChromaDB / Supabase pgvector)
CHROMADB_URL=http://localhost:8001
CHROMADB_COLLECTION=visualiq_transcripts
USE_SUPABASE_VECTOR=false

# Redis (Job Status & Event Bus)
REDIS_URL=redis://localhost:6379

# Ingestion & Video Pipeline Parameters
FRAME_SAMPLE_FPS=0.2
MOTION_THRESHOLD=0.08
MAX_BURST_FRAMES=5
ANOMALY_ALERT_THRESHOLD=6

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
